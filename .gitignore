# ====================================================================
# 🔐 SECURITY & ENCRYPTION KEYS (CRITICAL - NEVER REMOVE)
# ====================================================================
# Blocks your Snowflake cryptographic key-pair tokens from the internet
*.pem
*.pub
*.key
*.json

# ====================================================================
# 🗄️ LOCAL DATABASES & STORAGE
# ====================================================================
# Blocks local SQLite database tracking tables from bloating your repo
*.db
*.sqlite
*.sqlite3

# ====================================================================
# ⚙️ DBT SYSTEM CACHES & ENVIRONMENT LOGS
# ====================================================================
# Blocks local dbt metadata compilation outputs and automated logs
target/
dbt_packages/
logs/
dbt_modules/
modules/
*.log

# ====================================================================
# 🐍 PYTHON SYSTEM CLUTTER
# ====================================================================
# Blocks temporary background processing files generated by Python scripts
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
env/
venv/

# ====================================================================
# 🍏 MACOS SYSTEM FILES
# ====================================================================
# Blocks invisible Mac system folder indexing files
.DS_Store
.vscode/

# ====================================================================
# DATA STORAGE FILES
# ====================================================================
# Blocks local data storage files from being tracked by the repository
*.csv
*.json
